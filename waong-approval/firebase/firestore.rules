rules_version = '2';

// 와옹이 사용 승인 Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 그대로 붙여 넣고 [게시]를 누릅니다.
// 명단은 config/access 문서 하나로 관리합니다(SETUP.md 4단계).
//   approvers      : 승인 담당자 이메일 목록 (결재 가능)
//   allowedEmails  : 신청할 수 있는 이메일 목록
//   allowedDomains : 신청할 수 있는 이메일 도메인 목록 (예: ybm.co.kr)
// 이메일과 도메인은 모두 소문자로 적습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }
    function isApprover() {
      return signedIn() && email() in access().approvers;
    }
    function isMember() {
      return signedIn() && (
        email() in access().approvers ||
        email() in access().allowedEmails ||
        email().split('@')[1] in access().allowedDomains
      );
    }
    function validRequest(d) {
      return d.keys().hasOnly(['team', 'contact', 'project', 'site', 'medium', 'usage', 'start', 'end',
                               'purpose', 'link', 'requesterId', 'createdAt', 'revisedAt', 'extendsId', 'draftId'])
        && d.project is string && d.project.size() <= 200
        && d.purpose is string && d.purpose.size() <= 5000;
    }

    // 명단: 승인 담당자만 읽고, 고치는 것은 Firebase 콘솔에서만
    match /config/{doc} {
      allow read: if isApprover();
      allow write: if false;
    }

    // 신청서: 명단에 있는 사람은 모두 보고, 자기 신청만 만들고 고친다. 결재 전에만 철회할 수 있다
    match /requests/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.requesterId == request.auth.uid
        && validRequest(request.resource.data);
      allow update: if isMember()
        && resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterId == request.auth.uid
        && validRequest(request.resource.data);
      allow delete: if isMember()
        && resource.data.requesterId == request.auth.uid
        && !exists(/databases/$(database)/documents/decisions/$(id));
    }

    // 결재: 명단에 있는 사람은 보고, 승인 담당자만 쓴다
    match /decisions/{id} {
      allow read: if isMember();
      allow write: if isApprover();
    }

    // 이름 표시용 프로필: 본인 이름만 쓴다
    match /profiles/{uid} {
      allow read: if isMember();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100;
    }

    // 사람마다 알림 읽음 기록: 본인만
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
